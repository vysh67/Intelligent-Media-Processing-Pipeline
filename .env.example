# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Storage Directories
STORAGE_DIR=storage
UPLOADS_DIR=storage/uploads
PROCESSED_DIR=storage/processed
DB_PATH=storage/database.sqlite

# Concurrency & Worker Queue
QUEUE_CONCURRENCY=3
MAX_RETRIES=3
RETRY_BASE_DELAY_MS=1000

# File Upload Limits
MAX_FILE_SIZE_BYTES=15728640

# Computer Vision & Heuristics Thresholds
BLUR_LAPLACIAN_MIN=75.0
BLUR_NORMALIZED_MIN=40.0
BRIGHTNESS_LOW_MIN=45.0
BRIGHTNESS_HIGH_MAX=225.0
DUPLICATE_HAMMING_MAX=6
